function parseCatalogRows(values, sheetName) {
  const headers = (values[0] || []).map((value) => String(value).trim());
  for (const name of ['เลขครุภัณฑ์', 'S/N', 'ชื่ออุปกรณ์']) {
    if (headers.filter((header) => header === name).length !== 1)
      throw Object.assign(new Error(`${sheetName}: ไม่พบคอลัมน์ ${name} หรือมีคอลัมน์ซ้ำ`), {
        status: 422,
      });
  }
  const records = values.slice(1).flatMap((row, index) => {
    const get = (name) => String(row[headers.indexOf(name)] ?? '').trim();
    const asset = get('เลขครุภัณฑ์');
    if (!asset) return [];
    const photo = get('รูป (ลิงก์)');
    return [
      {
        row: index + 2,
        asset,
        serial: get('S/N'),
        name: get('ชื่ออุปกรณ์'),
        ...(photo ? { photo } : {}),
      },
    ];
  });
  return { records };
}

function readyToBorrowData(values = []) {
  return parseCatalogRows(values, 'พร้อมยืม');
}

function matchCatalog(records, query) {
  const words = query.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);
  return words.length
    ? records.filter((r) => {
        const text = [r.asset, r.serial, r.name].join(' ').toLocaleLowerCase();
        return words.every((word) => text.includes(word));
      })
    : records;
}
function catalogCategory(name) {
  return /keyboard|คีย์บอร์ด/i.test(name)
    ? 'คีย์บอร์ด (Keyboard)'
    : /mouse|เมาส์/i.test(name)
      ? 'เมาส์ (Mouse)'
      : /printer|เครื่องพิมพ์|เครื่องปริ้น/i.test(name)
        ? 'เครื่องพิมพ์เอกสาร (Printer)'
        : /monitor|จอมอนิเตอร์/i.test(name)
          ? 'หน้าจอ (Monitor)'
          : /laptop|notebook|โน๊ตบุ๊|โน้ตบุ๊/i.test(name)
            ? 'คอมพิวเตอร์พกพา (Laptop Computer)'
            : /คอมพิวเตอร์|desktop|all in one/i.test(name)
              ? 'คอมพิวเตอร์ตั้งโต๊ะ (Desktop Computer)'
              : 'อื่นๆ';
}

const assetIdentityKey = (record) => JSON.stringify([record.asset, record.serial]);
