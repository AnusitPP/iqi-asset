PORT=3000
GOOGLE_PHOTO_FOLDER_ID=1C42KW3QDHJ2X4scDba0p11TV1xM4L8-z
# Private JSON containing client_id, client_secret, refresh_token for the Drive owner (My Drive).
GOOGLE_DRIVE_OAUTH_FILE=
HOST=0.0.0.0
GOOGLE_SPREADSHEET_ID=1IvDnE8yCqN232ZuaXgNSj-42Zm4k1IjDYFNgsXXWdHo
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
SHEET_IQI=IQI
SHEET_ALL_ITEMS=สำเนาของ รายการทั้งหมด
SHEET_ALL=สำเนาของ ALL
# Set this to the exact existing IQI inspection-date header if detection is ambiguous.
IQI_DATE_HEADER=หมายเหตุ
IQI_DATE_MODE=inspection-note

# Vercel only: paste the entire private JSON into Vercel Environment Variables.
# Leave empty locally to use GOOGLE_*_FILE above. Never commit real values.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_OAUTH_JSON=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Bare hostnames, comma-separated. Vercel deployment/production URLs are allowed automatically.
ALLOWED_HOSTS=
# Default false. true explicitly makes uploaded Drive photos publicly readable.
PUBLIC_PHOTO_PREVIEW=false

# Google user login (separate from Sheets/Drive credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=step.cmu.ac.th

# Public OAuth callback origin. Local Express callback stays on port 3000.
# On Vercel use the actual HTTPS production origin registered with Google OAuth.
APP_URL=http://localhost:3000
# Optional destination after Google login when frontend and backend use different ports.
FRONTEND_URL=http://localhost:3001

# Separate private authentication workbook (Users/Admins/Sessions/AuditLogs)
AUTH_SPREADSHEET_ID=
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# Additional exact Google email addresses allowed to sign in (comma-separated)
GOOGLE_ALLOWED_EMAILS=
# Server-only SMTP configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=
MAIL_FROM=your-account@gmail.com

MAIL_REMINDER_SHEET=รายการยืมครุภัณฑ์
MAIL_REMINDER_ID_HEADER=เลขรายการยืม
MAIL_REMINDER_EMAIL_HEADER=email

# Random secret, at least 32 characters; set the same value in Vercel Production
CRON_SECRET=
