  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "googleapis": "^164.0.0",
    "heic-convert": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
