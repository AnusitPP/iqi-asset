{
  "name": "iqi-asset-checker",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:sheets": "node backend/scripts/setup-sheets.js",
    "drive:connect": "node backend/scripts/drive-connect.js",
    "dev": "node backend/server.js",
    "start": "node backend/server.js",
    "test": "node --test",
    "check": "node --check backend/server.js && node --check api/index.js && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "format": "prettier --write .",
    "build": "npm run build:web",
    "dev:web": "npm run dev --workspace @iqi/web",
    "build:web": "npm run build --workspace @iqi/web",
    "start:web": "npm run start --workspace @iqi/web",
    "typecheck:web": "npm run typecheck --workspace @iqi/web",
    "lint:web": "npm run lint --workspace @iqi/web",
    "test:web": "node apps/web/scripts/run-tests.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "googleapis": "^164.0.0",
    "heic-convert": "^2.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10"
  },
  "workspaces": [
    "apps/web"
  ]
}
